<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>false</IsPackable>

    <RootNamespace>Remotely.Server.Tests</RootNamespace>

    <AssemblyName>Remotely.Contract.DtoGolden.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- MessagePack version Microsoft.AspNetCore.SignalR.Protocols.MessagePack 10.0.14 resolves, i.e. what the .NET 10 desktop client
         (Desktop.Core) serializes DTOs with; the server only relays byte[]. The golden files were written with 2.1.90 (v2022.09.16.1006
         desktop): DtoGoldenTests compares them by content, ignoring map key order (2.5.x writes the inherited DtoType key first). -->
    <PackageReference Include="MessagePack" Version="2.5.303" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- [CallerFilePath] in the linked sources keeps the golden files in Tests/Server.Tests/Contract/Golden. -->
    <Compile Include="..\Server.Tests\Contract\DtoGoldenTests.cs" Link="Contract\DtoGoldenTests.cs" />
    <Compile Include="..\Server.Tests\Contract\SampleFactory.cs" Link="Contract\SampleFactory.cs" />
    <Compile Include="..\Server.Tests\Contract\GoldenFile.cs" Link="Contract\GoldenFile.cs" />
  </ItemGroup>

</Project>
